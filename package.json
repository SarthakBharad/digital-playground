{
  "name": "sarthaks-digital-playground",
  "version": "0.1.0",
  "private": true,
  "description": "Sarthak's Digital Playground — one question a week, answered with data. Next.js, TypeScript, Tailwind CSS v4.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
